# ---------------------------------------------------------------------------
# Traxac — environment configuration
# Copy to .env for local development:  cp .env.example .env && pnpm gen:env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# Railway injects DATABASE_URL automatically when a Postgres plugin is linked.
DATABASE_URL=postgres://localhost:5432/traxac_dev
DATABASE_POOL_MAX=10

# --- Secrets ---------------------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Losing this key makes every stored GST credential unrecoverable.
TRAXAC_MASTER_KEY=
TRAXAC_MASTER_KEY_VERSION=1
# Set only while rotating keys; remove once all rows are re-wrapped.
# TRAXAC_MASTER_KEY_PREVIOUS=

SESSION_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# --- Object storage --------------------------------------------------------
# local = write under ./.storage (development only). Production requires s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# S3_BUCKET=traxac-documents
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- GST / e-Invoice / e-Way Bill gateways ---------------------------------
# Stays on `sandbox` until real production credentials are provisioned.
GST_ENVIRONMENT=sandbox
IRP_SANDBOX_BASE_URL=https://einv-apisandbox.nic.in
IRP_PRODUCTION_BASE_URL=https://einvoice1.gst.gov.in
EWB_SANDBOX_BASE_URL=https://einv-apisandbox.nic.in
EWB_PRODUCTION_BASE_URL=https://ewaybillgst.gov.in
# Integrator credentials issued by NIC / your GSP. Without these the gateway
# refuses to run rather than inventing responses.
# NIC_CLIENT_ID=
# NIC_CLIENT_SECRET=
GATEWAY_TIMEOUT_MS=30000

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# --- URLs ------------------------------------------------------------------
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
