# Copy to keystore.properties and fill in. NEVER commit the real file.
#
# Generate an upload key once:
#   keytool -genkey -v -keystore ewayvo-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias ewayvo
#
# Losing this key means you can never update the app on Google Play again.
# Store it in a password manager and keep an offline backup.

storeFile=/absolute/path/to/ewayvo-upload.jks
storePassword=
keyAlias=ewayvo
keyPassword=
